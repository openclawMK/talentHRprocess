node_modules/
.env
backend/uploads/*
!backend/uploads/.gitkeep
dist/
.DS_Store
*.log

# landing/ is the real source for the marketing page deployed via
# frontend/public/landing.html + landing-assets/ (see landing/README-less
# build: `cd landing && npm run build`, then copy dist/* over). Only its
# own build artifacts/deps are excluded -- the source itself is worth
# keeping, since losing it means reverse-engineering the deployed bundle
# again from scratch, as happened once already.
landing/node_modules/
landing/dist/

# *.mp4 blocks video files from bloating the repo by accident, EXCEPT the
# one video actually deployed via frontend/public/ -- that's real content
# the landing page's "How It Works" modal plays, not an accidental add.
*.mp4
!frontend/public/peoplehire-intro.mp4
